node_modules/
dist/
*.log
.DS_Store
*.pem
.vercel/

# Next.js build output (.next-dev keeps dev separate from production builds)
.next/
.next-dev/

# Environment files — these hold the service-role key, which bypasses RLS
.env
.env.local
.env*.local
packages/ingest/.env

# Superseded scaffolding from the first MVP. Left on disk for reference only;
# create-bucket.js, setup-db.js and setup-data.js have a service-role key
# hardcoded, so this directory must never be published.
legacy/

# Playwright screenshots
apps/web/e2e/*.png

# Incremental typecheck cache, and the throwaway screenshot harnesses that
# only ever exist while a layout is being tuned.
*.tsbuildinfo
apps/web/e2e/_*.mjs

# El JSON de credenciales que descarga Google Cloud trae el client_secret en
# texto plano. No hace falta en el repo: el secreto vive en el panel de
# Supabase, no acá.
client_secret*.json
